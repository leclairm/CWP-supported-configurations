&master_nml
    lrestart = .false.
    lrestart_write_last = .true.
/

&master_time_control_nml
    calendar = 'proleptic gregorian'
/

&time_nml
    is_relative_time = .false.
/

&master_model_nml
    model_type = 1
    model_name = "atmo"
    model_namelist_filename = "NAMELIST_R02B07-R02B07_control_1979_atmo"
/

&master_model_nml
    model_type = 2
    model_name = "ocean"
    model_namelist_filename = "NAMELIST_R02B07-R02B07_control_1979_ocean"
/

&jsb_control_nml
    is_standalone = .false.
    debug_level = 0
    timer_level = 0
/

&jsb_model_nml
    model_id = 1
    model_name = "land"
    model_shortname = "lnd"
    model_description = "JSBACH land surface model"
    model_namelist_filename = "NAMELIST_R02B07-R02B07_control_1979_land"
/
